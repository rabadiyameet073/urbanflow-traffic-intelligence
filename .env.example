# UrbanFlow AI — environment contract
#
# Copy to `.env` for local development. Never commit `.env`.
# Every variable below is optional: the worker boots with safe defaults and
# degrades to the deterministic template copilot when Meta credentials are absent.

# --- Edge: EVP authentication -------------------------------------------------
# HMAC-SHA256 key for signed emergency-vehicle preemption requests.
# The development default is intentionally obvious so a leaked dev value is
# recognisable. Production must set this via `wrangler secret put`.
EVP_HMAC_SECRET=dev_evp_secret_key_32_chars_long

# --- Edge: CORS ---------------------------------------------------------------
# Comma-separated allow-list. A literal `*` is ignored on purpose: the gateway
# reflects an origin only when it appears in this list, and always sends
# `Vary: Origin`.
ALLOWED_ORIGINS=https://urbanflow-ai.pages.dev,http://localhost:5173

# --- Edge: Meta AI copilot ----------------------------------------------------
# Absent META_API_KEY => Meta provider is skipped; the chain falls through to
# Workers AI and then to the deterministic template. No request fails because
# of a missing key.
META_API_KEY=
META_API_BASE=https://api.dev.meta.ai/v1
META_MODEL=muse-spark-1.3
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Edge: budget -------------------------------------------------------------
# Global daily ceiling on copilot calls. Per-IP limits (20/hour, 10 s minimum
# interval) are enforced in code and are not configurable here.
AI_DAILY_CAP=1500

# --- Edge: MongoDB persistence ------------------------------------------------
# MongoDB connection URI and database name for simulation runs and telemetry storage.
# Supports local MongoDB (mongodb://127.0.0.1:27017) and MongoDB Atlas clusters.
# If offline or unset, edge automatically uses graceful in-memory storage fallback.
# Configuration entry point: the @urbanflow/db package (see db/README.md and ADR-0021).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=urbanflow

# --- Pipeline: MongoDB analytics mirror (optional) ---------------------------
# The Spark job can also mirror its 10s lane_metrics + anomalies into MongoDB
# alongside the Parquet lake (Parquet stays the source of truth, ADR-0008).
# Leave MONGO_URI empty to disable. If unset it falls back to MONGODB_URI above,
# so one running MongoDB can serve both the edge and the pipeline. From inside
# the Spark container reach a host-local mongod at host.docker.internal:27017.
MONGO_URI=
MONGO_DB=urbanflow

# --- Web ----------------------------------------------------------------------
# Base URL for the edge API. Leave empty to use same-origin `/api`.
VITE_API_BASE=
