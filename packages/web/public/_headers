# Cloudflare Pages header rules for the static dashboard.
#
# This is deliberately NOT a copy of SECURITY_HEADERS in
# packages/edge/src/http/index.ts. Three differences, each on purpose:
#
#   1. The Worker serves JSON only, so it can afford `default-src 'none'`.
#      This origin serves an application, so the policy has to allow scripts,
#      styles and fonts.
#   2. The Worker is `X-Robots-Tag: noindex` because it is an API. This is the
#      public page and must stay indexable (Module 33).
#   3. `worker-src 'self'` exists here and nowhere else: since Module 31 the
#      simulation runs in a Worker, and a CSP without it blocks the app.
#
# COEP is omitted on purpose. It is only needed for SharedArrayBuffer, this app
# uses transferable buffers instead, and COEP would break the cross-origin font
# stylesheet below. COOP alone is safe here and is required by Module 14 §4.2.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.workers.dev; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Hashed assets never change under the same name; the HTML must not be cached
# across a deploy or a judge keeps an old bundle.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
