{
  "name": "urbanflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @urbanflow/web dev",
    "dev:web": "pnpm --filter @urbanflow/web dev",
    "dev:edge": "npx tsx scripts/dev-edge.mjs",
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:regression": "node scripts/run-regression.mjs",
    "typecheck": "tsc -b",
    "verify": "pnpm typecheck && pnpm test && pnpm docs:check && pnpm build && pnpm check:meta && pnpm fitness",
    "bench": "pnpm --filter @urbanflow/bench bench",
    "repro": "pnpm --filter @urbanflow/bench repro",
    "docs:check": "node scripts/docs-check.mjs",
    "api:gen": "node scripts/gen-api-schemas.mjs",
    "api:check": "node scripts/gen-api-schemas.mjs --check",
    "eval:gen": "tsx evals/generate.mjs",
    "eval:replay": "tsx evals/replay.mjs",
    "eval:live": "tsx evals/live.mjs",
    "fitness": "node scripts/fitness.mjs",
    "check:meta": "node scripts/check-meta.mjs packages/web/dist/index.html",
    "security": "node scripts/fitness.mjs --only=secrets,headers,writer"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
